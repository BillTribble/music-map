{
  "name": "music-map-events-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8788",
    "db:init:local": "wrangler d1 execute music-map-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute music-map-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply music-map-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply music-map-db --remote",
    "db:migrate:plays:local": "wrangler d1 execute music-map-db --local --file=./migrations/0002_play_tracking.sql",
    "db:migrate:plays:remote": "wrangler d1 execute music-map-db --remote --file=./migrations/0002_play_tracking.sql",
    "db:migrate:requests:local": "wrangler d1 execute music-map-db --local --file=./migrations/0003_music_map_requests.sql",
    "db:migrate:requests:remote": "wrangler d1 execute music-map-db --remote --file=./migrations/0003_music_map_requests.sql",
    "requests:list": "wrangler d1 execute music-map-db --remote --command \"SELECT id, created_at, track_title, era, requester_email, note, country FROM music_map_requests ORDER BY id DESC LIMIT 50;\"",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.14.0"
  }
}
